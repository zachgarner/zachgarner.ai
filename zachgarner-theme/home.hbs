{{!< default}}

<section class="posts">
  <div class="posts-grid">
    {{#get "posts" filter="tag:-hash-brief" limit="3" include="tags"}}
      {{#foreach posts}}
        <a href="{{url}}" class="post">
          <span class="category">{{#if primary_tag}}{{primary_tag.name}}{{/if}}</span>
          <h3>{{title}}</h3>
          <p>{{excerpt words="30"}}</p>
          <span class="date">{{date format="MMM YYYY"}}</span>
        </a>
      {{/foreach}}
    {{/get}}
  </div>
</section>

<section class="briefs">
  <div class="briefs-grid">
    <div class="section-label" style="margin-top:1.5rem;">Briefs</div>

    {{#get "posts" filter="tag:hash-brief" limit="5" include="tags"}}
      {{#foreach posts}}
        <a href="{{url}}" class="brief">
          <span class="brief-date">{{date format="MMM D"}}</span>
          <div class="brief-body">
            <h3>{{title}}</h3>
            <p>{{excerpt words="15"}}</p>
          </div>
          <span class="brief-category">{{#if primary_tag}}{{primary_tag.name}}{{/if}}</span>
        </a>
      {{/foreach}}
    {{/get}}
  </div>

  <div class="subscribe-cell">
    <div class="sidebar-label">Stay in the loop</div>
    <p class="subscribe-text" style="max-width:16rem;">Monthly updates on what I'm building, thinking through, and learning. No bs, no spam. Tell your agent I said hi.</p>
    <form data-members-form class="subscribe-form">
      <input type="email" placeholder="you@email.com" class="subscribe-input" data-members-email required>
      <button type="submit" class="subscribe-btn">Subscribe</button>
    </form>
  </div>
</section>

<section class="deep-dives">
  <div class="section-label" style="margin-top:1.5rem;">Deep Dives</div>
  <div class="deep-dive-toc">
    <div class="deep-dive-intro">
      <h3>Fine-Tuning VLAs at Scale</h3>
      <p>VLA models collapse the robotics stack into a single end-to-end system. Training them on proprietary data breaks the infrastructure patterns that worked for LLMs.</p>
      <p style="margin-top:0.5rem;">The full training pipeline - from raw data through production evaluation - for teams building on VLA foundation models.</p>
      <span class="deep-dive-meta">Physical AI &middot; 5 parts</span>
    </div>
    <div class="deep-dive-parts">
      <a href="#" class="deep-dive-part"><span class="part-num">1</span> The Data Problem</a>
      <a href="#" class="deep-dive-part"><span class="part-num">2</span> Decoupling CPU and GPU Scaling</a>
      <a href="#" class="deep-dive-part"><span class="part-num">3</span> Distributed Data Loading</a>
      <a href="#" class="deep-dive-part"><span class="part-num">4</span> Training Loop Optimization</a>
      <a href="#" class="deep-dive-part"><span class="part-num">5</span> Evaluation at Scale</a>
    </div>
  </div>
</section>
