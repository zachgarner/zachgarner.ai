{{!< default}}

<section class="archive-section">
  <h1>All Writing</h1>
  {{#foreach posts}}
    <a href="{{url}}" class="archive-post">
      <div class="archive-post-title">{{title}}</div>
      <div class="archive-post-meta">{{#if primary_tag}}{{primary_tag.name}} / {{/if}}{{date format="MMM YYYY"}}</div>
    </a>
  {{/foreach}}
</section>

{{pagination}}
