<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#is "home"}}{{@site.title}}{{else}}{{meta_title}} - {{@site.title}}{{/is}}</title>
  <meta name="description" content="{{meta_description}}">
  <link rel="canonical" href="{{canonical_url}}">
  <link rel="icon" type="image/png" href="{{asset "favicon.png"}}">
  {{ghost_head}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Lora:ital,wght@0,400;0,600;1,400&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{asset "css/style.css"}}">
</head>
<body class="{{body_class}}">
  <div class="page">
    {{> header}}
    {{{body}}}
    {{> footer}}
  </div>
  {{ghost_foot}}
</body>
</html>
